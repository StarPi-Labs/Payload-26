# ── Role: COPROCESSOR ────────────────────────────────────────────────
# ESP-Hosted coprocessor firmware (works with both MCU and Linux hosts
# via the unified MCU RPC v1 wire).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# Wi-Fi ON: ESP-NOW runs on the Wi-Fi stack, and the P4 keeps network access
# through the C6. (Espressif's peer-data example ships with it off.)
CONFIG_ESP_WIFI_ENABLED=y
# BT stays off for now - nothing on the P4 uses it yet.
CONFIG_BT_ENABLED=n

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# OS
CONFIG_FREERTOS_HZ=1000

# Feature
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
