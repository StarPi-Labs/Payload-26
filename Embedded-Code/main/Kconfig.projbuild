menu "Star-PI Payload Configuration"

    comment "──── Peripheral Enables ────"

    config ENABLE_I2C_BUS
        bool "Enable I2C bus (required for any I2C sensor)"
        default y
        help
            Initialise the shared I2C master bus.
            Must be enabled if any I2C sensor is enabled.

    config ENABLE_MPU6050
        bool "Enable MPU-6050 (accelerometer + gyroscope, 0x68)"
        default y
        depends on ENABLE_I2C_BUS
        help
            MPU-6050 6-axis IMU on I2C address 0x68.
            Produces 14 bytes per sample: accel(6) + temp(2) + gyro(6).

    config ENABLE_BME680
        bool "Enable BME680 (pressure / temp / humidity, 0x76)"
        default n
        depends on ENABLE_I2C_BUS
        help
            BME680 environmental sensor on I2C address 0x76.
            Produces 8 raw bytes per sample.

    config ENABLE_INA219
        bool "Enable INA219 (current / voltage / power, 0x40)"
        default n
        depends on ENABLE_I2C_BUS
        help
            Adafruit INA219 power monitor on I2C address 0x40.
            Measures bus voltage, shunt voltage, current, and power.
            Produces 8 raw bytes per sample.

    config ENABLE_GPS
        bool "Enable GPS module (UART)"
        default n
        help
            GPS receiver connected via UART (e.g. u-blox NEO-6M).

    config ENABLE_SD_SDIO
        bool "Enable SD card logging through SDIO"
        default n
        help
            Log all sensor data to a CSV file on the SD card (SDMMC 1-bit).

    config ENABLE_SD_SPI
        bool "Enable SD card logging through SPI"
        default y
        help
            Log all sensors data to a binary file on the SD card (SD SPI)

    comment "──── Sampling ────"

    config SAMPLE_INTERVAL_MS
        int "Sensor sample interval (ms)"
        default 10
        range 1 10000
        help
            Delay between sensor read cycles (all sensors).
            10 ms ≈ 100 Hz,  1 ms ≈ 1 kHz (if I2C bandwidth allows).

    comment "──── I2C Pin Configuration ────"

    config I2C0_MASTER_SDA
        int "I2C0 SDA GPIO"
        default 26
        depends on ENABLE_I2C_BUS
        help
            GPIO number for I2C master data line.

    config I2C0_MASTER_SCL
        int "I2C0 SCL GPIO"
        default 27
        depends on ENABLE_I2C_BUS
        help
            GPIO number for I2C0 master clock line.

    config I2C1_MASTER_SDA
        int "I2C1 SDA GPIO"
        default 13
        depends on ENABLE_I2C_BUS
        help
            GPIO number for I2C1 master data line.

    config I2C1_MASTER_SCL
        int "I2C1 SCL GPIO"
        default 14
        depends on ENABLE_I2C_BUS
        help
            GPIO number for I2C1 master clock line.

    config I2C_MASTER_FREQUENCY
        int "I2C clock frequency (Hz)"
        default 400000
        depends on ENABLE_I2C_BUS
        help
            I2C master clock speed. 400000 = Fast Mode.

    comment "──── GPS UART Configuration ────"

    config GPS_TXD_PIN
        int "GPS TX GPIO (ESP → GPS)"
        default 6
        depends on ENABLE_GPS

    config GPS_RXD_PIN
        int "GPS RX GPIO (GPS → ESP)"
        default 7
        depends on ENABLE_GPS
    
    comment "GPS set 115200 as baud"
    config GPS_BAUD_RATE
        int "GPS baud rate"
        default 9600
        depends on ENABLE_GPS

    comment "──── SD Card Pin Configuration ────"

    config SD_SPI_MOSI_PIN
        int "SD SPI MOSI GPIO"
        default 23
        depends on ENABLE_SD_SPI

    config SD_SPI_MISO_PIN
        int "SD SPI MISO GPIO"
        default 19
        depends on ENABLE_SD_SPI

    config SD_SPI_SCLK_PIN
        int "SD SPI SCLK GPIO"
        default 18
        depends on ENABLE_SD_SPI

    config SD_SPI_CS_PIN
        int "SD SPI CS PIN"
        default 5
        depends on ENABLE_SD_SPI

    config SD_CLK_PIN
        int "SD CLK GPIO"
        default 14
        depends on ENABLE_SD_CARD

    config SD_CMD_PIN
        int "SD CMD GPIO"
        default 15
        depends on ENABLE_SD_CARD

    config SD_D0_PIN
        int "SD D0 GPIO"
        default 2
        depends on ENABLE_SD_CARD

endmenu
